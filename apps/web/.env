# Default: connected mode through the Vite dev proxy (vite.config.ts forwards
# /api and /ws to apps/server on :8787, so no CORS is needed). "/" also holds
# for a production build served same-origin by the server.
# Demo mode (synthetic community from src/lib/demo.ts): `npm run dev:demo`,
# which sets this to an empty string.
VITE_ADA_SERVER=/
