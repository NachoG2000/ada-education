# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files
.env
.env.*
# ...except the web client's, which carries no secret: it only says the SPA
# talks to its own origin (VITE_ADA_SERVER=/). Without it a fresh clone builds
# the synthetic demo instead of the real client — Vite inlines this at build
# time, so a runtime variable can't fix it afterwards.
!apps/web/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# playwright mcp artifacts
.playwright-mcp/
.impeccable/

# server local
apps/server/data/
*.tsbuildinfo

# vendored agent skills (restorable via `npx skills add`; see skills-lock.json)
.agents/skills/
.claude/skills/lark-*

# ada-runner local state (card id map); the wiki itself is versioned
data/**/agents/*/.ada/
