# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files
.env
.env.*
# The tracked web configuration contains only VITE_ADA_SERVER=/, no secret.
# The hosted client also defaults to the page origin when this file is absent.
!apps/web/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# playwright mcp artifacts
.playwright-mcp/
.impeccable/

# server local
apps/server/data/
*.tsbuildinfo

# vendored agent skills (restorable via `npx skills add`; see skills-lock.json)
.agents/skills/
.claude/skills/lark-*

# ada-runner local state (card id map); the wiki itself is versioned
data/**/agents/*/.ada/

# personal drafts (applications, notes); never part of the public repo
private/

# Installation agent host credentials and private workspaces
.ada/
