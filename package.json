{
  "name": "ada",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run seed && concurrently -n web,server,runner \"npm run dev:web\" \"npm run dev:server\" \"ADA_RUNTIME=${ADA_RUNTIME:-scripted} npm run runner\"",
    "dev:demo": "npm run dev:demo -w @ada/web",
    "dev:web": "npm run dev -w @ada/web",
    "dev:server": "npm run dev -w @ada/server",
    "runner": "tsx packages/runner/src/cli.ts --cwd data/neural-networks-2026/agents/ada --token ada-demo-token",
    "seed": "npm run seed -w @ada/server",
    "build": "npm run build -w @ada/web",
    "lint": "oxlint apps packages",
    "typecheck": "tsc -b apps/web",
    "smoke": "npm run smoke -w @ada/server",
    "check:docker": "bash deploy/check-docker.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
