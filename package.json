{
  "name": "ada",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev -w @ada/web",
    "dev:server": "npm run dev -w @ada/server",
    "runner": "tsx packages/runner/src/cli.ts",
    "seed": "npm run seed -w @ada/server",
    "build": "npm run build -w @ada/web",
    "lint": "oxlint apps packages",
    "typecheck": "tsc -b apps/web",
    "smoke": "npm run smoke -w @ada/server",
    "check:workspace": "npm run check:workspace -w @ada/server",
    "check:issue1": "npm run check -w @ada/protocol && npm run check:hosted -w @ada/protocol && npm run check -w @ada/server && npm run check:issue1 -w @ada/server && npm run check -w @ada/runner && npm run check:providers -w @ada/runner && npm run build",
    "check:docker": "bash deploy/check-docker.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
